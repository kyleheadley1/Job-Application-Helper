# Copy this file to `.env` at the repository root (monorepo-wide).
# Never commit real secrets.

# API server
PORT=4000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/job_agent_mvp
MONGO_DB_NAME=job_agent_mvp

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional local override for resume context folder.
# Default if unset: apps/api/data/resumes
RESUME_CONTEXT_DIR=

# Tracker seed/import behavior on API startup.
# When true, API re-imports the tracker workbook on boot (idempotent upsert by importKey).
AUTO_IMPORT_TRACKER_ON_START=true
# Optional override path. Default: data/job_role_scores_current.xlsx
TRACKER_SEED_WORKBOOK_PATH=

# Triage speed controls
# When true, keep triage behavior but favor faster deterministic resume selection in ambiguous cases.
TRIAGE_FAST_MODE=false
TRIAGE_SKIP_LLM_RESUME_SELECTION_IN_FAST_MODE=true

# Warm local resume context cache during API startup (reduces first-triage latency).
PRELOAD_RESUME_CONTEXT_ON_START=true

# Web -> API base URL
VITE_API_BASE_URL=http://localhost:4000/api

# Top Jobs: roles from LinkedIn / Indeed / ZipRecruiter / Remote Hunter job-alert emails.
# Needs Gmail connected (below). Indeed/ZipRecruiter job pages are bot-blocked, so their roles
# are looked up on the employer's ATS via Serper (1 credit each, shares SERPER_MAX_QUERIES_TOTAL).
TOP_JOBS_SYNC_ENABLED=true
# 6:00 AM US Eastern (America/New_York) — cron uses TOP_JOBS_SYNC_TIMEZONE
TOP_JOBS_SYNC_CRON=0 6 * * *
TOP_JOBS_SYNC_TIMEZONE=America/New_York
TOP_JOBS_SYNC_SCHEDULE_HOUR=6
TOP_JOBS_SYNC_SCHEDULE_MINUTE=0
TOP_JOBS_SYNC_CATCHUP_ON_START=true
TOP_JOBS_MAX_TRIAGES_PER_SYNC=15
TOP_JOBS_MIN_SCORE=70
TOP_JOBS_LISTING_MAX_AGE_DAYS=14
# Default 1 min in development, 60 in production (override either way)
TOP_JOBS_MANUAL_REFRESH_COOLDOWN_MIN=60

# Chrome extension shared secret (paste the same value into the extension options page)
EXTENSION_API_TOKEN=

# Gmail dashboard (Google Cloud OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/oauth/callback
WEB_APP_URL=http://localhost:5173

# JD recovery for Gmail applications. Serper is only used when the email has no usable job link or JD.
SERPER_API_KEY=
# Lifetime Serper query budget. The free grant is 2,500 one-time queries; at most 2 queries per job.
SERPER_MAX_QUERIES_TOTAL=1250
# Reasoning effort for Gmail email classification (minimal | low | medium | high). JD scoring is unaffected.
# GMAIL_CLASSIFY_REASONING_EFFORT=minimal
# Timezone assumed for interview times that an email gives without one (default: this machine's zone).
# USER_TIMEZONE=America/New_York
# OpenAI prices (USD per 1M tokens) used for the dashboard cost estimate; defaults are gpt-5-mini.
# OPENAI_INPUT_PRICE_PER_M=0.25
# OPENAI_CACHED_INPUT_PRICE_PER_M=0.025
# OPENAI_OUTPUT_PRICE_PER_M=2
# Applications scored per "Recover JDs" run (each triage takes ~40-60s)
JD_RECOVERY_MAX_PER_RUN=5
# Minutes between background Gmail syncs while the API runs (0 disables). Only new emails cost anything.
# GMAIL_AUTO_SYNC_MINUTES=15
